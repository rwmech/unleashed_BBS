# The W5500's driver: in IDF 5.3.1's own esp_eth (components/esp_eth/src/
# spi/w5500), off by default. SPI Ethernet support itself is already on in
# every build (ETH_USE_SPI_ETHERNET defaults to y); this is the one chip.
CONFIG_ETH_SPI_ETHERNET_W5500=y

# An address DHCP takes back while the cable stays in (a NAK, a lease run
# out) is reported lost after this many seconds, and only then does Wi-Fi
# take over (main.cpp, ethWatch). The IDF's 120 would leave the board dark
# for two minutes; 10 is past a lease renewal's own retries on a LAN.
CONFIG_ESP_NETIF_IP_LOST_TIMER_INTERVAL=10

# Wi-Fi beside the wire (1.2.1-eth.2): the station is joined as well as the
# wire, and the camera's snap wants 32,256 bytes of internal heap and a
# 17 KB DMA block (camera.cpp, roomToSnap). Wi-Fi's static buffers are
# internal RAM whatever is joined, about 1.6 KB each: 6 receive and 6 send
# rather than the S3 layer's 10 and 10 give back about 13 KB, and callers
# are on the wire, so Wi-Fi carries the link's frames and little else. The
# block-ack window follows the receive buffers, as the IDF advises. Ranges
# in IDF 5.3.1's Kconfig: RX 2-25, TX 1-64, BA window 2-32 (a value out of
# range is dropped, not clamped: check sdkconfig.ws_s3eth after a change).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

# mDNS's allocations in PSRAM, not internal RAM (it can: SPIRAM_USE_MALLOC
# is on in the S3 layer). Answers and probes are small and rare.
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# The camera's internal DMA buffer (ETH 1.0.1). On the S3 esp32-camera takes
# 16 x 1 KB for JPEG (target/esp32s3/ll_cam.c, ll_cam_dma_sizes) and up to
# this figure for raw frames; 16 KB caps both, so one bring-up needs 17 KB
# of internal DMA memory, not the ESP32's 33 (platform.h, kCamDmaBlock).
# The bench's first SNAPSHOT was refused with the largest block at 31,744
# against the ESP32 figure; a 40 KB reserve pool, the Freenove's answer,
# made it 27,648 (the SSH task's stack lands in it) and was taken out.
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384

# The camera driver (espressif/esp32-camera) with the sensors this board is
# sold with. Every sensor is on by default and their register tables are
# initialised data (the Freenove's plan measured all seventeen at 9,800
# bytes of static DRAM against 1,768 for the OV2640 alone). The bench's
# board carries an OV2640; Waveshare's wiki and factory demo name the
# OV5640 as the camera it is sold with too, so both.
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=n
CONFIG_OV5640_SUPPORT=y
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n

# The VFS table is 12 on every S3 (sdkconfig.defaults.esp32s3, 1.2.1).
