# The program and its constants run from PSRAM (XIP), copied there from
# flash at boot, as every Waveshare demo for this board runs. The reason is
# the panel: an RGB panel is fed from PSRAM continuously, and a flash write
# (every LittleFS write) otherwise turns the cache off for its length, which
# starves the panel (the glass tears or drifts) and would crash an interrupt
# that reads PSRAM. With code and rodata in PSRAM, IDF 5.3.1's flash driver
# leaves the cache on through a write (spi_flash_os_func_app.c,
# SPI_FLASH_CACHE_NO_DISABLE). About 1.3 MB of the 8 MB is taken by the copy.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# The RGB driver's interrupt in IRAM, so its bounce buffers are refilled
# whatever the cache is doing, and the DMA restarted at every VSYNC so that
# a refill that was ever late costs one frame, never a picture that stays
# shifted (the IDF's own advice for RGB panels, esp_lcd Kconfig).
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# The VFS table, 8 to 12 (1.1.2-hw.1, the Makerfabs' fix, MF35 1.1.1). The
# console, lwIP's sockets, the three LittleFS partitions, SSH's eventfd and
# the SD card's FAT fill the IDF's 8 exactly on an S3 with SSH, with nothing
# spare: one more descriptor-backed driver and the card's mount fails with
# ESP_ERR_NO_MEM, which esp_vfs_register returns for a full table (vfs.c,
# s_vfs_count >= VFS_MAX_COUNT). 4 bytes a slot.
CONFIG_VFS_MAX_COUNT=12
