# The camera's internal DMA buffer (WS2 1.0.1, as the ESP32-S3-ETH's 1.0.1).
# On the S3 esp32-camera takes 16 x 1 KB for JPEG (target/esp32s3/ll_cam.c,
# ll_cam_dma_sizes) and up to this figure for raw frames; 16 KB caps both, so
# a bring-up needs 17 KB of internal DMA memory, not the ESP32's 33
# (platform.h, kCamDmaBlock, which asserts this).
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384

# The camera driver (espressif/esp32-camera 2.1.7, src/idf_component.yml)
# with the sensors this board's 24-pin connector is sold with: Waveshare
# ship an OV5640 and name the OV2640 as the other that fits (wiki). Every
# sensor is on by default and their register tables are initialised data,
# so the rest are off, as on the other camera boards. OV5640 autofocus
# stays off (its default): the module Waveshare sell is fixed focus.
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=n
CONFIG_OV5640_SUPPORT=y
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n

# The VFS table, 8 to 12 (1.1.2-hw.1, the Makerfabs' fix, MF35 1.1.1). The
# Makerfabs failed at 8 because its second console took the slot its card
# needed; its review counted every other S3 profile with SSH at 8 of 8 once
# the card is mounted: working, with no headroom, so one more VFS user (a
# driver, a second console) and the card's mount fails with ESP_ERR_NO_MEM,
# which esp_vfs_register returns for a full table (vfs.c, s_vfs_count >=
# VFS_MAX_COUNT). 4 bytes a slot. The LCD-1.47 stays at 8 as released.
CONFIG_VFS_MAX_COUNT=12
