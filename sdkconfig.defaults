# Bluetooth off: the single biggest RAM saving on this module
CONFIG_BT_ENABLED=n

# Flash layout
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Sockets: 1 listener + 6 nodes + 1 busy line + spares (lwIP ceiling is 16)
# Sixteen is lwIP's hard maximum in IDF 5.3.1: the Kconfig is "range 1 16,
# default 10". A value outside that range in a defaults file is DISCARDED
# rather than clamped, silently, so asking for 24 here gave the board 10 and
# nobody noticed until a map file was read. Seven callers then filled a board
# advertising ten nodes and the eighth accept() failed.
#
# Budget at 16: the listener, mDNS and SNTP take three, leaving thirteen. Ten
# caller lines plus the busy line and the sysop node is twelve sessions, and
# announce and the backup window each want one while they are active. So a
# completely full board with a backup window open can still run out; ten
# nodes is the honest number for a part that cannot go past sixteen sockets.
CONFIG_LWIP_MAX_SOCKETS=16

# FATFS: one shared sector window instead of one per open file.
#
# esp_vfs_fat_sdspi_mount makes a single contiguous allocation of
# sizeof(vfs_fat_ctx_t) + max_files * sizeof(FIL), and with a per-file cache
# every FIL carries its own 512 byte window. At the 20 open files sixteen
# caller nodes need, that is about 12 KB in one block, and on a board whose
# static RAM is already 175 KB it is the allocation that fails: the card
# reported ESP_ERR_NO_MEM at every bus speed, which is what told us it was
# never a signal problem.
#
# With this off, FF_FS_TINY is 1 and the open files share the filesystem's
# window, so the same 20 files cost a few hundred bytes. The price is more
# sector re-reads when several files are read interleaved. The BBS streams
# one screen at a time, so it pays almost nothing for it.
CONFIG_FATFS_PER_FILE_CACHE=n

# FATFS: long filenames, because without them a file area is unusable.
#
# The IDF default is CONFIG_FATFS_LFN_NONE, which is strict 8.3: a path
# component of more than eight characters is not merely awkward, it is an
# invalid name, so FatFs refuses to create it and refuses to open it. A
# sysop typing "storage/textfiles" into CONFIG got a folder that was never
# made and an area that reported "that folder is not on the card any more",
# with nothing in the log saying why. Worse, every file already on the card
# with an ordinary modern name would have been invisible to the listing, and
# that would only have been discovered once downloads worked.
#
# 8.3 is the wrong constraint for this board anyway. The point of the card
# is that a sysop fills it from a laptop, and a laptop does not make 8.3
# names. The era being honoured is the software, not the filesystem's
# limits.
#
# HEAP rather than STACK: the buffer is (MAX_LFN + 1) * 2 bytes and the BBS
# loop task's stack is not the place to find another quarter kilobyte per
# open directory. 128 is generous for a BBS file and well short of the 255
# maximum, which would cost twice as much for names nobody types.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128

CONFIG_LWIP_SO_REUSE=y

# 1 ms tick so effect timing is smooth
CONFIG_FREERTOS_HZ=1000

# app_main only does setup
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# ---------------------------------------------------------------------------
# Full CPU speed, 240 MHz, on every board (1.1.1)
# ---------------------------------------------------------------------------
# The IDF default is 160. 240 is the top of the choice on both the ESP32 and
# the ESP32-S3, so the one line here serves every profile; no layer after
# this file sets it. Rule no. 1 is paid in CPU time as much as in design:
# the loop, a screen's fx and the camera's re-encode all run faster. A
# choice value that does not exist is dropped silently, so the generated
# sdkconfig.<env> is the proof: it must say CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# (SYS and HARDWARE read the running speed from the clock, not from here).
# As with everything in this file, delete sdkconfig.<env> for it to take on
# a tree that already built.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---------------------------------------------------------------------------
# The task watchdog reboots a wedged board (1.1.0)
# ---------------------------------------------------------------------------
# The IDF default only prints a warning, so a board whose loop wedged stayed
# wedged, answering nothing, until somebody noticed and pulled the plug. With
# PANIC the board restarts itself, and reboots.log and the next staff login
# say "task watchdog", because the panic handler leaves that as the reset
# reason (esp_reset_reason_set_hint in task_wdt.c).
#
# What is watched: the idle task on each core (IDF default, left on), which
# catches a task that spins without yielding, and the BBS loop itself,
# subscribed in main.cpp once the board is up and fed once a pass, which
# also catches a loop that blocks for ever.
#
# 30 s rather than the default 5, because the timeout is the longest single
# pass allowed and the right price is the one a real pass cannot reach. The
# longest measured on a board is 342 ms; the longest known are seconds (a
# restore unpacking its largest file onto a nearly full partition, a DNS
# lookup when CONFIG restarts the plugins with the network down). A board
# that has genuinely wedged loses nothing that matters in the extra 25 s.
# Kconfig allows 1..60.
#
# sdkconfig.<env> is generated once and then kept, and a value it already
# holds wins over this file: delete sdkconfig.esp32dev (and the release
# one) for a change here to take, and check the generated file afterwards.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Smaller image leaves OTA headroom
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ---------------------------------------------------------------------------
# Heap: the board ran out of it, and these are where it goes
# ---------------------------------------------------------------------------
# A live board was measured at 19,736 bytes of minimum free heap and was
# seen to restart on its own, caught only because MEM's "heap low since
# boot" figure had gone UP, which a high-water mark can only do across a
# reboot. Nothing in this firmware allocates on that scale: the whole of
# src/ has two heap allocations, the chat room buffer and the backup
# inflater. The heap goes to lwIP and Wi-Fi.
#
# The send buffer and window are per socket, from the same heap, and there
# are sixteen sockets. 5760 bytes each is sized for bulk TCP throughput
# this board does not do: XMODEM and YMODEM are stop-and-wait, one block
# then wait for the ACK, so a large window is never filled, and chat lines
# and menus are hundreds of bytes. 2880 is still two full segments at the
# 1440 byte MSS, which is what matters for not stalling on delayed ACKs.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# Wi-Fi dynamic buffers are allocated on demand and 32 of each is generous
# for a board whose busiest moment is ten callers reading text. The static
# RX pool is untouched, since that one is preallocated and is what keeps
# the radio from dropping frames under burst.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# The radio never sleeps on this board.
#
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE defaults ON and lets the IDF put
# the radio into power management on its own. On a mains powered BBS the
# saving buys nothing and the cost is real: a dozing station waits for the
# next DTIM beacon before it hears anything, which on this AP measured as
# about a second. Seen twice on the live board as a tight cluster of pings
# at 1.02 s while the gateway stayed flat at 0 ms, and a tight cluster on a
# round number is a timer rather than interference.
#
# The application still calls esp_wifi_set_ps(WIFI_PS_NONE) and that remains
# the primary mechanism. This is belt and braces, so that a path which does
# not run it cannot leave the radio asleep.
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# Flash trims that cost a caller nothing (1.1.1, Rob, from the optimize
# report internal/memory-2026-09-25-1.1.1.md, sections 3.2 and 3.3).
#
# IPv6 off. Every socket the firmware opens is AF_INET (the listener, the
# backup window, announce), nothing creates an IPv6 link-local address and
# IPv6 autoconfig was already off, so no board has ever had an IPv6 address
# to be called on. About 26 KB of flash and 1.8 KB of static DRAM.
CONFIG_LWIP_IPV6=n
# SoftAP and WPA2-Enterprise off. The board is only ever a station
# (esp_wifi_set_mode(WIFI_MODE_STA), main.cpp), Improv runs over the serial
# port, a captive portal was declined for good (2026-09-22), and nothing in
# the firmware or CONFIG network sets an 802.1X identity or certificate, so
# neither could be used. About 44 KB of flash.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
