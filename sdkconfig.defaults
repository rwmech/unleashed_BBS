# Bluetooth off: the single biggest RAM saving on this module
CONFIG_BT_ENABLED=n

# Flash layout
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Sockets: 1 listener + 6 nodes + 1 busy line + spares (lwIP ceiling is 16)
# Sixteen is lwIP's hard maximum in IDF 5.3.1: the Kconfig is "range 1 16,
# default 10". A value outside that range in a defaults file is DISCARDED
# rather than clamped, silently, so asking for 24 here gave the board 10 and
# nobody noticed until a map file was read. Seven callers then filled a board
# advertising ten nodes and the eighth accept() failed.
#
# Budget at 16: the listener, mDNS and SNTP take three, leaving thirteen. Ten
# caller lines plus the busy line and the sysop node is twelve sessions, and
# announce and the backup window each want one while they are active. So a
# completely full board with a backup window open can still run out; ten
# nodes is the honest number for a part that cannot go past sixteen sockets.
CONFIG_LWIP_MAX_SOCKETS=16

# FATFS: one shared sector window instead of one per open file.
#
# esp_vfs_fat_sdspi_mount makes a single contiguous allocation of
# sizeof(vfs_fat_ctx_t) + max_files * sizeof(FIL), and with a per-file cache
# every FIL carries its own 512 byte window. At the 20 open files sixteen
# caller nodes need, that is about 12 KB in one block, and on a board whose
# static RAM is already 175 KB it is the allocation that fails: the card
# reported ESP_ERR_NO_MEM at every bus speed, which is what told us it was
# never a signal problem.
#
# With this off, FF_FS_TINY is 1 and the open files share the filesystem's
# window, so the same 20 files cost a few hundred bytes. The price is more
# sector re-reads when several files are read interleaved. The BBS streams
# one screen at a time, so it pays almost nothing for it.
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_LWIP_SO_REUSE=y

# 1 ms tick so effect timing is smooth
CONFIG_FREERTOS_HZ=1000

# app_main only does setup
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Smaller image leaves OTA headroom
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
