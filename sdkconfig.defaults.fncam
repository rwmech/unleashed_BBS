# PSRAM: the WROVER-E's 8 MB, quad, on GPIO 16 and 17, at the default 40 MHz
# (80 needs the flash at 80 too). Only 4 MB of it is mappable by malloc on
# the classic ESP32; the rest needs himem, and nothing here wants it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# No memory test at boot: the web installer's Improv deadline is measured
# from the reset it causes (sdkconfig.defaults.esp32s3 has the reasoning).
CONFIG_SPIRAM_MEMTEST=n
# Wi-Fi's and lwIP's buffers in PSRAM first, as on the S3.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# This image on a board without PSRAM boots as a plain BBS rather than
# panicking in a loop. Only possible while BSS stays internal.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Revision 3 minimum. Below it the whole image is built with the PSRAM cache
# workaround, which measured 33 KB of flash. The board read as v3.1, and no
# WROVER-E carries an older chip; the price is that this image will not boot
# on a pre-v3 ESP32.
CONFIG_ESP32_REV_MIN_3=y

# The camera driver (espressif/esp32-camera, src/idf_component.yml) with the
# one sensor this board carries. Every sensor is on by default, and their
# register tables are initialised data: all seventeen measured 9,800 bytes
# of static DRAM against 1,768 for the OV2640 alone (the plan, section 4).
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=n
CONFIG_OV5640_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
