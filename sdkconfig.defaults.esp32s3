# Flash: DIO at 80 MHz, which is how Waveshare's own demo runs this part.
# QIO is untried here and is a measured step for later. The image header
# says 8 MB (1.1.2), the size of the S3 layout (partitions_s3.csv), so the
# same image boots on the Waveshare's 16 MB part and on an 8 MB N8R8:
# IDF 5.3.1 refuses to start when the header claims more flash than the
# chip has (esp_flash_spi_init.c), and a larger chip is only a warning. The
# directory's system badge reports the header's size, so it reads 8 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: the 8 MB in the R8's package is octal, on GPIO 26 to 37 with the
# flash (which is why syscfg::pinProblem refuses those on an S3). Nothing
# static moves into it yet: CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is a
# separate, measured step, and even then only what is marked EXT_RAM_BSS_ATTR
# moves. What uses it now is the panel's framebuffer, allocated at the panel
# plugin's start.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# No PSRAM memory test at boot. It walks all 8 MB before app_main runs, and
# the web installer's Improv question has a deadline measured from the reset
# it causes: 1.5 s, after which a board already running this firmware is
# offered a fresh install instead of Update (main.cpp, "Why during boot").
# The test earns nothing a crash on a bad part would not also say.
CONFIG_SPIRAM_MEMTEST=n
# Wi-Fi's and lwIP's buffers in PSRAM first, internal RAM only when that
# fails (Espressif's own option for exactly this). Measured on the first
# flash without it: internal heap 35,707 free and 20,415 at its lowest, out
# of 248,219, with nobody on, because with PSRAM enabled the IDF also
# switches Wi-Fi to sixteen preallocated internal TX buffers. The lights and
# the panel were both refused at start for want of internal heap while
# eight megabytes of PSRAM sat idle.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Wi-Fi's static buffers, 16/16 to 10/10 (1.1.2), and the block-ack window
# to match the receive buffers, as the IDF advises. TRY_ALLOCATE_WIFI_LWIP
# raises both defaults to 16, and PSRAM forces static TX buffers, all in
# internal RAM: about 19 KB back (internal/memory-2026-09-25-1.1.1.md item
# 7, measured on the Freenove, which runs 10/10), for the SSH task's stack
# and its crypto. Ten is the WROOM's own RX figure and more TX than a
# telnet board keeps in flight; frames past ten wait in the cache queue.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=10

# The console on the S3's own USB (USB-Serial-JTAG), as the primary console.
# The Waveshare stick has no USB-serial bridge: its USB-A plug goes straight
# to GPIO 19 and 20, and UART0 reaches only two header pins. Primary rather
# than secondary because a secondary console is output only, and Improv has
# to read what the web installer sends (IDF's USB-Serial-JTAG console guide:
# "if you also want to input ... please select
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG").
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The VFS table, 8 to 12, for every S3 (1.2.1; the Makerfabs' fix of MF35
# 1.1.1, until then in four boards' own layers and not the LCD-1.47's). Two
# consoles (UART0 and the USB-Serial-JTAG secondary), lwIP's sockets, the
# three LittleFS partitions and SSH's eventfd (1.1.2) filled the IDF's 8 on
# the Makerfabs, so the SD card's FAT was the ninth and its mount failed with
# ESP_ERR_NO_MEM, which esp_vfs_register returns for a full table (vfs.c,
# s_vfs_count >= VFS_MAX_COUNT): "no card: not enough memory" with 1.7 MB of
# PSRAM free (the bench, 2026-09-28). Every one-console S3 with SSH is at 8
# of 8 once the card is mounted, so the next VFS user would take the card
# down. Here rather than per board: ESP-IDF reads this layer for every
# esp32s3 build, and board.h refuses an S3 image built without it. 4 bytes a
# slot of static DRAM.
CONFIG_VFS_MAX_COUNT=12
