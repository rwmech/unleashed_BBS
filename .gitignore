.pio/
.vscode/
build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.*
!sdkconfig.defaults
# The S3 layer ESP-IDF reads after sdkconfig.defaults (1.1.0). A source file,
# not a generated one, though the pattern above would take it.
!sdkconfig.defaults.esp32s3
include/secrets.h
data/system.cfg
data/calls.log
CLAUDE.local.md

# Anything *.local.md is private working material and never ships.
# The repo is intended to go public, so an idea that is not ready to be
# public does not live in a tracked file, not even a private repo's:
# git history is forever and "we were private then" is not a defence.
*.local.md

# Claude Code's per-machine settings: permission allowlists full of local
# paths and commands. Was only ignored by a global excludes file, which a
# fresh clone on another machine does not have.
.claude/settings.local.json
host/bbs_host
host/bbs_host_s3
# Every compiled test, by pattern rather than by name. Naming them one
# at a time meant test_wrap's binary was committed the day it was
# written, 72 KB of build output in the tree, and nothing noticed
# because git status stops mentioning a file once it is tracked.
host/test_*
!host/test_*.cpp
__pycache__/
/*.zip
/backup/
data/users.txt
data/logs/

# Release builds (tools/release.py). Published as GitHub Release assets,
# never committed: binaries do not belong in the history.
release/
