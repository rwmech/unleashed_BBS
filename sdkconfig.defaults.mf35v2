# with this program. If not, see <https://www.gnu.org/licenses/>. The full
# text is in the LICENSE file at the top of this repository.
# ===========================================================================

# PSRAM: octal, 8 MB, exactly as the S3 layer sets it for the Waveshare's R8.
# Nothing to change.

# The console on UART0, which the CP2104 carries to the USB-C port marked
# USB-TTL: the port with auto-reset, the flashing port and Improv's port.
# The S3 layer puts it on the chip's own USB, for the Waveshare stick.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
