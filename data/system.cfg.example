# File:        data/system.cfg.example
# Description: Run-time settings for the BBS. Copy to data/system.cfg
#              (git-ignored) for a fresh board: pio run -t flashall
#              On a running board, change it through the backup zip
#              instead (BACKUP.md): no reflash, applies at once.
#              key = value, '#' starts a comment.

# This board's name, up to 40 characters: the welcome screen says who a
# caller is connecting to, and the directory lists the board under it.
# Empty means the software's own name.
board_name = My Board

# Network name for DHCP and mDNS (name.local). a-z 0-9 -, applies at boot.
hostname = unleashed

# Timezone as a POSIX TZ string: STDoffsetDST,start,end. CONFIG board picks
# one by name from a list of 34 zones and writes the string here for you.
#   offset is hours WEST of UTC (so US zones are positive)
#   M3.2.0 = March, 2nd week, Sunday; M11.1.0 = November, 1st week, Sunday
# Examples:
#   UTC0                        UTC, no daylight saving
#   EST5EDT,M3.2.0,M11.1.0      US Eastern
#   CST6CDT,M3.2.0,M11.1.0      US Central
#   MST7MDT,M3.2.0,M11.1.0      US Mountain
#   MST7                        Arizona (no daylight saving)
#   PST8PDT,M3.2.0,M11.1.0      US Pacific
#   GMT0BST,M3.5.0/1,M10.5.0    UK
#   CET-1CEST,M3.5.0,M10.5.0/3  Central Europe
tz = UTC0

ntp_server = pool.ntp.org

# The Wi-Fi network, applies at boot. Easiest set with Improv over USB (see
# README.md), which writes these two lines for you. Taken exactly as typed:
# a '#' here is part of the value, not a comment. The password is 8 to 64
# characters, or empty for an open network. It is NOT redacted in a backup,
# which only a local address can download.
wifi_ssid =
wifi_password =

# The port callers dial, applies at boot like the network above (CONFIG
# network sets it). 1 to 65535, never the same as backup_port. A router
# forwarding to the board has to forward to this number.
port = 6400

# Staff passwords, entered at any prompt as: BYE <password>
# A wrong password is a normal logoff; 3 wrong from one IP in 15 min = 15 min ban.
# Empty disables that level. Max 32 characters, case-sensitive.
#   sysop     moves to the hidden sysop node, has every permission
#   cosysop1  stays on its node, CO1 column below
#   cosysop2  stays on its node, CO2 column below
#
# With no sysop_password line at all, the board uses the published default,
# unleashed, from its own network only, and offers to set itself up to the
# first local caller. Setting it (CONFIG staff) writes the line. Leave the
# line out on a new board; an empty line means "no sysop", not "default".
# sysop_password =
cosysop1_password =
cosysop2_password =

# The sysop's own account (CONFIG board, Sysop): missed rings are mailed
# to it, and it is asked for the sysop password when it logs in. Both
# lines are written together by CONFIG and by the first-boot setup; the
# id is what counts, so a renamed account keeps its mail. Unset, the last
# account to elevate to sysop stands in.
# sysop_handle =
# sysop_id = 0

# Idle hangup at the command prompt, warning 1 minute before. 0 = never.
# (The handle prompt always warns at 30 s and hangs up at 60 s.)
idle_minutes = 20

# Time limits in minutes, 0 = unlimited
call_minutes = 60
day_minutes = 480

# Backup window (BACKUP.md): the BOOT button, pressed while the sysop is
# logged in, opens http://<board>:<backup_port>/ for this many minutes.
# backup_button_gpio = -1 disables the button and the window.
backup_port = 8080
backup_window_minutes = 5
backup_button_gpio = 0

# WHO n and DASH n: allowed refresh interval, seconds
who_refresh_min = 1
who_refresh_max = 30

# LED blinked on network traffic. 2 is the blue LED on DOIT-style
# ESP32 dev boards; set -1 if your board has none there.
activity_led_gpio = 2

# User accounts (USERS.md). self_register = no: unknown handles are refused
# and staff add accounts with USERS / USER ADD. max_users is 1..250.
self_register = yes
max_users = 100

# Guests: an unknown handle is offered [G]uest; no account, nothing saved,
# marked with * in lists.
# guest_minutes per call (0 = unlimited); guests have no daily limit.
guest = yes
guest_minutes = 15

# Plugins (PLUGINS.md). Every plugin reads its own section. A plugin that
# is not enabled costs nothing: no commands, no hooks, no memory.
#   read/write/admin take: all, users, staff, co2, co1, sysop, none
#   read   who may look
#   write  who may change something
#   admin  who may configure the plugin itself
# Keys that are not in a section must stay above this line.
[plugin:example]
enabled = no
read  = all
write = staff
admin = sysop
greeting = hello

# One chat room, DDial style. write = all lets guests talk too.
# Chat is on even without this section; enabled = no turns it off.
[plugin:chat]
enabled = yes
read  = all
write = all
admin = sysop
room = Main
rate = 80        ; lines a minute one caller may send, 8 in a burst
history = 48     ; lines the room remembers, 8 to 2000

; Mail: several per caller, 3 on the board's own flash and 12 with an SD
; card, read and answered from MAIL. Not private: plain text on the board's
; storage. Not in the backup zip.
mail_slots = 32  ; messages the board holds at once, 0 switches mail off
mail_chars = 512 ; longest a message may be
mail_days  = 14  ; how long one waits before it expires

; Room colours. Any C64 colour name: black white red cyan purple green
; blue yellow orange brown ltred darkgrey grey ltgreen ltblue ltgrey
color_node    = cyan      ; the #2 in "#2:Daytona) hi"
color_punct   = darkgrey  ; the : and the rank bracket
color_handle  = ltgreen   ; the handle
color_text    = white     ; what was said
color_old     = darkgrey  ; history shown on the way in
color_notice  = yellow    ; *** joined, left, votes, kicks
color_room    = cyan      ; the banner and /s
color_private = purple    ; a line meant for one caller

# Share a serial device: one operator types, everyone else watches.
# Uses the second UART, never the console, so flashing still works.
# Pins 6-11 (flash) and 1/3 (console) are refused; tx cannot be 34-39.
[plugin:serial]
enabled = no
read  = all
write = staff
admin = sysop
rx = 16
tx = 17
baud = 115200
format = 8N1

# An SD card over SPI. On even without this section; a board with no card
# carries on without one. The pins are the wiring page's.
[plugin:sd]
enabled = yes
cs      = 5         ; GPIO. Move to 4 if the board will not boot with a card
mosi    = 23
clk     = 18
miso    = 19
screens = yes       ; screens on the card override the stock set, per file
; A full backup into the card's backup folder every night at 03:00, named
; nightly-YYYYMMDD.zip, the last 7 kept. It holds the Wi-Fi password, as
; every full backup does. BACKUP SD makes one by hand (BACKUP.md).
nightly = no

# Two strings of WS2812B pixels for a board in a case: a drive light and a
# strip of ten. Off until switched on and given pins; -1 is no pin. Pins
# 6-11 (flash) are refused, and the two cannot share a pin. Brightness is a
# percentage, 1 to 30: the firmware reads anything higher as 30. Ten pixels
# at full white draw about 600 mA, so give the strip its own 5 V supply.
# COMMANDS.md describes every effect.
[plugin:lights]
enabled      = no
drive_pin    = -1          ; GPIO13 is a good choice
drive_fx     = pc          ; pc, 1541, disk2, breathe, off
drive_bright = 10
strip_pin    = -1
strip_fx     = nodes       ; nodes, hayes, blinken, scanner, c64, boing, vu, rainbow, manual, off
strip_bright = 10
# In manual mode, one line per pixel, led1 to led10: effect | colour
# led1       = sparkle | random

# Staff access matrix. X = allowed, - = denied.
# SYSOP always has everything; its column is there for reference.
# Keep this section last: every line after [access] is a matrix row.
#
#   NODES      NODES list with IPs, IPs in LAST
#   KICK       KICK n (only callers and lower staff levels)
#   BROADCAST  BROADCAST message
#   SNOOP      SNOOP n (only callers and lower staff levels)
#   TIME       TIME n +/-minutes
#   BANS       BANS list
#   UNBAN      UNBAN ip
#   HIDE       SHOW, HIDE, LURK
#   NOLIMITS   no idle timeout, no call or daily limit
#   DASH       DASH dashboard
#   USERS      USERS manager, USER ADD/EDIT/DEL, private fields in INFO
[access]
# permission   SYSOP  CO1  CO2
NODES          X      X    X
KICK           X      X    -
BROADCAST      X      X    X
SNOOP          X      X    -
TIME           X      X    X
BANS           X      X    X
UNBAN          X      -    -
HIDE           X      X    -
NOLIMITS       X      X    X
DASH           X      X    X
USERS          X      X    -

# Tell a directory server this board exists, so people can find it. Off
# until you switch it on. It sends the board's name, owner, description,
# port and how busy it is, and nothing whatever about callers: ANNOUNCE
# TEST prints the exact payload before you have to trust it.
#
# The directory records the address the heartbeat came from, so a board on
# a changing home address stays findable without dynamic DNS.
#
# servers is comma separated, up to four, and the default is replaceable:
# the format is documented in ANNOUNCE.md so anybody can run a directory.
# The name the directory shows is board_name at the top of this file.
#
# support and interests are badges: comma lists of the slugs the directory
# publishes (unleashedbbs.com lists them at /badges), up to 16 each in 95
# characters. The chip, the terminals, guests and what is running are sent
# as badges too, worked out by the board itself.
[plugin:announce]
enabled     = no
owner       = Somebody
description = One line about this board, up to 120 characters
servers     = http://unleashedbbs.net/announce
host        =              ; a DNS name of your own, if you have one
public_port =              ; what callers dial through your router; empty: the board's port
interval    = 10           ; minutes between heartbeats, 1 to 1440
token       =              ; only if your directory issues them
support     =              ; e.g. lgbtq, literacy
interests   =              ; e.g. c64, electronics, ham
