# with this program. If not, see <https://www.gnu.org/licenses/>. The full
# text is in the LICENSE file at the top of this repository.
# ===========================================================================

# PSRAM: the N16R2's 2 MB is QUAD, on the flash's bus (26 to 32). The S3
# layer's octal mode would find nothing, and would take 33 to 37, which are
# this board's panel bus. 80 MHz as the S3 layer has it.
CONFIG_SPIRAM_MODE_QUAD=y

# The console on UART0, which the CP2104 carries to the USB-C port marked
# USB-TTL: that is the port with auto-reset, the flashing port and Improv's port,
# as on the WROOM. The S3 layer puts the console on the chip's own USB
# because the Waveshare stick has no bridge. The IDF's default secondary
# console, USB-Serial-JTAG output, stays: the board's other USB-C port then
# shows the log too, and takes no input.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
