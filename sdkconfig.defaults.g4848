# The console on UART0, which the CH340 carries to the USB-C port: the
# flashing port (auto-reset), the monitor and Improv's port, as on the
# Makerfabs v1.0. No secondary console: USB-Serial-JTAG's pads are GPIO 19
# (the GT911's SDA) and 20 (the panel's G1) here, not a USB port, and a
# console there would also be a VFS slot for nothing.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# The program and its constants run from PSRAM (XIP), as on the 4.3B. The
# panel is fed from a framebuffer in PSRAM continuously, and a flash write
# (every LittleFS write) otherwise holds the PSRAM's bus for its length,
# which starves the panel's DMA; with code and rodata in PSRAM, IDF 5.3.1's
# flash driver leaves the cache on through a write (spi_flash_os_func_app.c,
# SPI_FLASH_CACHE_NO_DISABLE).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# The RGB driver's interrupt in IRAM, and the DMA restarted at every VSYNC,
# so a frame the DMA fell behind on costs that frame, never a picture that
# stays shifted (the IDF's own advice for RGB panels, esp_lcd Kconfig).
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# The VFS table, 8 to 12, as on every S3 display board: lwIP's sockets, the
# three LittleFS partitions, SSH's eventfd and the SD card's FAT, with the
# console, leave no headroom at 8, and a full table fails the card's mount
# with ESP_ERR_NO_MEM (vfs.c, s_vfs_count >= VFS_MAX_COUNT). 4 bytes a slot.
CONFIG_VFS_MAX_COUNT=12
